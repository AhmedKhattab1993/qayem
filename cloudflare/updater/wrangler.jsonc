{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qayem-updater",
  "account_id": "8157d695115b808345ee82fce21007f3",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": true},
  "containers": [{
    "class_name": "UpdateContainer", "image": "./Dockerfile",
    "image_build_context": "../..", "max_instances": 1,
    "instance_type": "basic"
  }],
  "durable_objects": {"bindings": [{"name": "UPDATER", "class_name": "UpdateContainer"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["UpdateContainer"]}],
  "workflows": [{"name": "qayem-nightly", "binding": "UPDATES", "class_name": "NightlyUpdate"}],
  "r2_buckets": [{"binding": "HISTORY", "bucket_name": "qayem-history"}],
  "d1_databases": [{
    "binding": "DB", "database_name": "qayem-public",
    "database_id": "3249fecc-5050-4913-afaa-329fa561e0ad"
  }],
  "triggers": {"crons": ["30 23 * * *", "30 0 * * *"]},
  "vars": {"QAYEM_SOURCES": "aqarexit", "QAYEM_BENCHMARK_SOURCES": "nawy_primary"}
}
